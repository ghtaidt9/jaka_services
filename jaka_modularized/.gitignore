# Terraform working directories
.terraform/
.terraform.lock.hcl

# State files (real state lives in S3; bootstrap/ keeps a local one)
*.tfstate
*.tfstate.*

# Crash logs and override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local variable files that may contain secrets
*.auto.tfvars
*.auto.tfvars.json

# Plan files
*.plan
*.tfplan

# LocalStack data + auth token
localstack/volume/
localstack/.env